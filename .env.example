# Déjalo vacío para usar el mismo origen (modo de despliegue por defecto).
VITE_API_BASE_URL=
# Destino del proxy /api del servidor de desarrollo (Vite).
API_PROXY_TARGET=http://localhost:8080
# Origen del contrato OpenAPI para `npm run contract:sync`.
CONTRACT_URL=http://localhost:8080/openapi/openapi.yml
# API que usa la suite E2E de Playwright.
E2E_API_URL=http://localhost:8080
# Puerto publicado por la imagen web para el recorrido del evaluador.
WEB_PORT=8081
# API local que Nginx alcanza desde el contenedor. En Linux se puede reemplazar si el firewall lo requiere.
API_UPSTREAM=http://host.docker.internal:8080
